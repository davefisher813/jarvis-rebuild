# JARVIS environment (UP-LAUNCH-04, 2026-09-05).
#
# Every variable the app or its serverless functions read, in one place. Copy
# what you need into .env.local for development; the real values live in the
# Vercel project (server + VITE_), Codemagic (the iOS build's VITE_ only) and
# nowhere else. src/laws/env.test.ts fails if a process.env read appears in
# api/ without a line here, so this file cannot quietly go stale.
#
# WHERE      vercel   = Vercel > Project > Settings > Environment Variables
#            codemagic= Codemagic > Workflow > Environment variables / groups
#            local    = jarvis-app/.env.local, never committed
# SECRET     yes = never in a build, never in a client bundle, never in git.
#            A VITE_ prefixed variable is COMPILED INTO THE BUNDLE and is
#            public by construction: never give one a secret value.

# ---------------------------------------------------------------- Supabase --
# The project the app talks to. The anon key is public by design (row level
# security is what protects the data); the service role key is not, and it
# bypasses every policy.
# where: vercel, codemagic, local
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Server-side aliases, read by api/ when the VITE_ pair is not exposed there.
# Set both spellings in Vercel: the functions accept either.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# SECRET. Required by api/ai.ts (rate limits), api/_admin.ts (every admin
# endpoint) and api/account/delete.ts (deleting a user). Without it AI rate
# limiting cannot run at all: see AI_REQUIRE_LIMITS below.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------- AI --
# SECRET. The only Anthropic credential; api/ai.ts is the only caller.
ANTHROPIC_API_KEY=
# The model every AI feature uses. Change deliberately: the golden set
# (src/ai/golden) is scored against whatever this names.
AI_MODEL=claude-sonnet-4-6
# The model used for the few calls that WRITE for the user (mail drafts).
# Unset means the same as AI_MODEL, which is the current launch choice: one
# model, one behaviour, one thing to reason about when output changes.
AI_MODEL_WRITE=claude-sonnet-4-6
# Per-user calls an hour. 120 is roughly ten times a heavy day.
AI_RATE_PER_HOUR=120
# Global calls a day, across every user: the cost kill switch.
AI_GLOBAL_PER_DAY=2000
# Request body caps in bytes: text, and an image for the vision path.
AI_MAX_INPUT_BYTES=32768
AI_MAX_VISION_BYTES=600000
# Fail closed when the service role key is missing, so a misconfigured deploy
# refuses AI rather than serving it uncapped to everyone. On since
# UP-LAUNCH-04; set it to 0 only in local development, where an uncapped
# proxy costs one person's key rather than everyone's.
AI_REQUIRE_LIMITS=1

# ------------------------------------------------------------------ Google --
# The OAuth client for Gmail and Calendar. The id is public (it ships in the
# bundle as VITE_GOOGLE_CLIENT_ID); the secret is not.
# where: vercel, codemagic (VITE_ only), local
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# SECRET.
GOOGLE_CLIENT_SECRET=
# SECRET. 32 random bytes, base64. This encrypts every stored refresh token:
# rotating it makes every existing Google connection unreadable, so users
# would have to reconnect. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_KEY=

# ------------------------------------------------------------------- Admin --
# Comma separated Supabase user ids allowed to reach /api/admin/*. UNSET MEANS
# NOBODY: api/_admin.ts fails closed on purpose, so a forgotten variable can
# never open the door. Dave's own uid is the launch value.
ADMIN_USER_IDS=
# Build flag: "1" tells the admin panel the privileged endpoints are deployed.
# where: vercel, codemagic
VITE_ADMIN_API=1
# SECRET. Read only by api/admin/billing.ts, which answers zeroes without it.
# Nothing in the app can be bought yet, so this stays empty until there is a
# paywall.
STRIPE_SECRET_KEY=

# --------------------------------------------------------------- The shell --
# Where the serverless API lives, as seen by the client. Empty on the website
# (same origin). The native build MUST set it: the bundle is served from
# capacitor://localhost, where a relative /api path has nowhere to go.
# where: codemagic (set in codemagic.yaml), local when testing the native shell
VITE_API_BASE=
# Error tracking (UP-LAUNCH-07). Set this and crashes go to Sentry instead of
# the app's own receiver: same reports, grouped and searchable, with the build
# id as the release. A Sentry DSN is public by design (it ships in the bundle
# and only permits writing), which is why it wears the VITE_ prefix. Empty
# means fall back to VITE_ERROR_SINK below.
# where: vercel, codemagic
VITE_SENTRY_DSN=
# Client error reporting: "1" posts crashes to the app's own receiver
# (api/client-error.ts); a full URL posts them anywhere that takes JSON;
# empty means no reporting, which is the dev and sandbox state.
# where: vercel, codemagic
VITE_ERROR_SINK=1

# ------------------------------------------------------- Build-time only ----
# Not configuration: these are switches passed on the command line by the
# build scripts, listed so nobody sets them in a dashboard by mistake.
#   SINGLEFILE=1  one openable index.html, WITH demo seed data
#   CLEAN=1       one openable index.html, no demo data (the backup build)
#   DEMO=1        demo seed data in a normal multi-file build
#   TESTPANEL=1   builds test.html instead of the app
